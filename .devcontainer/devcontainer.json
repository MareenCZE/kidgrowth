{
  "name": "Růst (growth tracker)",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Růst",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash .devcontainer/start-server.sh",
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client"]
    }
  }
}
