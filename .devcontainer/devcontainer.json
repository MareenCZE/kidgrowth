{
  "name": "Růst (growth tracker)",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Růst",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "nohup php -S 0.0.0.0:8080 -t src > /tmp/rust-server.log 2>&1 & disown",
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client"]
    }
  }
}
