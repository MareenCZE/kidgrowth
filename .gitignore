# Real configuration (storage backend choice, DB credentials) - copy
# config.sample.php to this and fill it in
src/config.php

# Generated reference data that is not public domain (see DATA-LICENCES.md).
# tools/build_reference_data.php fetches and writes these locally; only
# data/cdc.php (public domain) ships in the repository.
src/data/cav.php
src/data/breastfed.php
src/data/pol.php
src/data/who.php

# The JSON/SQLite storage backends' actual data: real children's real
# measurements. Never committed, regardless of where it's pointed.
storage/growth.json
storage/growth.sqlite

# Source files the reference build downloads before parsing them: a few
# megabytes of other people's PDFs and spreadsheets, kept so that an
# interrupted install resumes rather than starts again. The installer puts
# them in the first of these it can write to.
storage/reference-cache/
src/data/.cache/

# Basic Auth credentials for local/deployed instances
.htpasswd*

# Local scratch
.DS_Store

# Development backlog: working notes on what is done, half-done and merely
# considered. Kept in the working tree, deliberately not published - it is
# detail about the project's insides that its users have no use for.
docs/backlog.md
